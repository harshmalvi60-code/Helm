# ====================================================================
# HELM — environment variables
# Copy this file to .env.local for local dev, and add the same keys
# in Vercel → Project → Settings → Environment Variables for prod.
# Anything blank → that capability falls back to "demo mode" so the
# UI still works for development & screenshots.
# ====================================================================

# -------- Supabase (auth + database) --------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -------- Anthropic (Claude — AI insights) --------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# -------- HMAC secret used by OAuth state cookies --------
HELM_OAUTH_SECRET=replace-with-a-32+-char-random-string

# -------- Shopify (OAuth app) --------
# https://shopify.dev/docs/apps/build/authentication-authorization
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=read_orders,read_products,read_customers,read_inventory,read_analytics

# -------- Meta (Facebook / Instagram Ads) --------
# https://developers.facebook.com/docs/facebook-login
META_APP_ID=
META_APP_SECRET=
META_SCOPES=ads_read,business_management

# -------- Google (GA4 + Google Ads share one OAuth client) --------
# https://developers.google.com/identity/protocols/oauth2/web-server
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed if you'll actually query Google Ads:
GOOGLE_ADS_DEVELOPER_TOKEN=

# -------- Klaviyo --------
# https://developers.klaviyo.com/en/docs/set_up_oauth
KLAVIYO_CLIENT_ID=
KLAVIYO_CLIENT_SECRET=
KLAVIYO_SCOPES=campaigns:read profiles:read metrics:read flows:read
