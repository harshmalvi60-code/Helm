# ====================================================================
# HELM — environment variables (3 backend functions only)
# Copy to .env.local for local dev. In production, set the same keys
# in Vercel → Project → Settings → Environment Variables.
# ====================================================================

# -------- Supabase --------
# Used by /api/*.js (server side) and by the browser via window.HELM_CONFIG.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -------- HMAC secret for OAuth state cookies --------
# 32+ random characters. Run: openssl rand -hex 32
HELM_OAUTH_SECRET=

# -------- Shopify OAuth app --------
# Create a Shopify Partner app: https://partners.shopify.com/
# App URL:        https://your-domain/onboarding
# Callback URL:   https://your-domain/api/integrations/shopify/callback
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=read_orders,read_products,read_customers,read_inventory,read_analytics
SHOPIFY_API_VERSION=2024-07
